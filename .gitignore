# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tutor data (Learner progress lives here; use Export in the app to back it up)
/data/

# local-only: docs, design notes, Claude/agent instructions and throwaway spikes
/README.md
/CONTEXT.md
/docs/
/CLAUDE.md
/AGENTS.md
/.claude/
/spikes/

# unfinished curriculum phases (renamed back when their exercises are complete)
/curriculum/_wip-*/
__pycache__/
/.impeccable/
